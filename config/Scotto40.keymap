#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        language {
            bindings = <&kp LA(LSHFT)>;
            key-positions = <39 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Слой 0: QWERTY (4 строки по 10 клавиш)

            bindings = <
  &mt RIGHT_BRACKET Q  &kp W     &kp E         &kp R                 &kp T      &kp Y      &kp U          &kp I      &kp O     &mt LEFT_BRACKET P
  &kp A                &kp S     &kp D         &kp F                 &kp G      &kp H      &kp J          &kp K      &kp L     &mt SQT SEMICOLON
  &kp Z                &kp X     &kp C         &kp V                 &kp B      &kp N      &kp M          &kp COMMA  &kp DOT   &kp SLASH
  &kp LCTRL            &kp LALT  &lt 1 ESCAPE  &mt LEFT_SHIFT ENTER  &kp SPACE  &kp ENTER  &kp BACKSPACE  &lt 2 DEL  &kp LGUI  &kp TAB
            >;
        };

        lower_layer {
            // Слой 1: Цифры и навигация (активируется зажатием клавиши `mo 1`)

            bindings = <
  &mt KP_NUM KP_SLASH       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS  &kp C_VOLUME_UP    &kp PG_UP       &kp UP_ARROW     &kp PSCRN       &kp HOME
  &kp KP_MULTIPLY           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &kp K_MUTE         &kp LEFT_ARROW  &kp UP           &kp RIGHT       &kp CAPSLOCK
  &mt KP_EQUAL KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT    &kp C_VOLUME_DOWN  &kp PAGE_DOWN   &kp PAUSE_BREAK  &kp SCROLLLOCK  &kp END
  &trans                    &trans           &trans           &trans           &trans        &trans             &trans          &trans           &trans          &trans
            >;
        };

        layer_2 {
            bindings = <
  &mt F12 F1       &kp F2        &kp F3        &kp F4        &kp F5       &kp F6        &kp F7         &kp F8        &kp F9                &mt F11 F10
  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT  &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp NUMBER_6  &kp N7         &kp N8        &kp N9                &kp N0
  &trans           &trans        &trans        &trans        &trans       &trans        &trans         &trans        &trans                &trans
            >;
        };

        layer_3 {
            bindings = <
  &sys_reset  &bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans      &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans      &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp UNDERSCORE
  &trans      &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layer3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
