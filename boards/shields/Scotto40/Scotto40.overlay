#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: matrix_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        // Карта перенаправления (прямая матрица 4х10)
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row"; // Диоды идут от столбцов к строкам

        // Твои 10 столбцов в зеркальном порядке (маппинг под RP2040 Pro Micro)
        col-gpios
            = <&pro_micro 26 GPIO_ACTIVE_HIGH> // GP26
            , <&pro_micro 27 GPIO_ACTIVE_HIGH> // GP27
            , <&pro_micro 9  GPIO_ACTIVE_HIGH> // GP9
            , <&pro_micro 8  GPIO_ACTIVE_HIGH> // GP8
            , <&pro_micro 7  GPIO_ACTIVE_HIGH> // GP7
            , <&pro_micro 6  GPIO_ACTIVE_HIGH> // GP6
            , <&pro_micro 5  GPIO_ACTIVE_HIGH> // GP5
            , <&pro_micro 4  GPIO_ACTIVE_HIGH> // GP4
            , <&pro_micro 3  GPIO_ACTIVE_HIGH> // GP3
            , <&pro_micro 2  GPIO_ACTIVE_HIGH>;// GP2

        // Твои 4 строки (впиши актуальные пины, сейчас стоят GP10, GP11, GP12, GP13)
        row-gpios
            = <&pro_micro 22  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // GP22
            , <&pro_micro 20  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // GP20
            , <&pro_micro 23  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // GP23
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;// GP21
    };
};
 
